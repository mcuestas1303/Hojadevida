// ZonasEventosNY para TradingView — v1.0
// Marca la vela de 1 minuto de cada noticia (CPI, PPI, NFP, FOMC u otras) y la vela de apertura
// de Nueva York (9:30) de ese día, y proyecta ambas zonas hasta la última vela.
// TradingView no deja leer su calendario económico desde un indicador, así que las fechas van en
// el grupo "6. Calendario" y se pueden corregir o agregar sin tocar el código.
//@version=6
indicator("Zonas Eventos NY v1.0", shorttitle = "ZonasNY v1.0", overlay = true,
     max_boxes_count = 500, max_labels_count = 500, max_lines_count = 100)

const string TZ = "America/New_York"

// Fechas oficiales (BLS y Reserva Federal). Revísalas si alguna se reprograma.
const string FECHAS_CPI  = "2025-01-15,2025-02-12,2025-03-12,2025-04-10,2025-05-13,2025-06-11,2025-07-15,2025-08-12,2025-09-11,2025-10-24,2025-12-18,2026-01-13,2026-02-13,2026-03-11,2026-04-10,2026-05-12,2026-06-10,2026-07-14,2026-08-12,2026-09-11,2026-10-14,2026-11-10,2026-12-10"
const string FECHAS_PPI  = "2025-01-14,2025-02-13,2025-03-13,2025-04-11,2025-05-15,2025-06-12,2025-07-16,2025-08-14,2025-09-10,2025-11-25,2026-01-14,2026-01-30,2026-02-27,2026-04-14,2026-05-13,2026-07-15,2026-08-13,2026-09-10,2026-10-15"
const string FECHAS_NFP  = "2025-01-10,2025-02-07,2025-03-07,2025-04-04,2025-05-02,2025-06-06,2025-07-03,2025-08-01,2025-09-05,2025-11-20,2025-12-16,2026-01-09,2026-02-11,2026-03-06,2026-04-03,2026-05-08,2026-06-05,2026-07-02,2026-08-07,2026-09-04,2026-10-02,2026-11-06,2026-12-04"
const string FECHAS_FOMC = "2025-01-29,2025-03-19,2025-05-07,2025-06-18,2025-07-30,2025-09-17,2025-10-29,2025-12-10,2026-01-28,2026-03-18,2026-04-29,2026-06-17,2026-07-29,2026-09-16,2026-10-28,2026-12-09"

// ── Parámetros (ordenados de lo que más se cambia a lo que casi nunca se toca) ─────────────────
G1 = "1. Noticias a mostrar"
iCPI   = input.bool(true,  "CPI - IPC (8:30 NY)", group = G1)
iPPI   = input.bool(true,  "PPI - Precios al productor (8:30 NY)", group = G1)
iNFP   = input.bool(false, "NFP - Nóminas no agrícolas (8:30 NY)", group = G1)
iFOMC  = input.bool(false, "FOMC - Decisión de tipos de la Fed (14:00 NY)", group = G1)
iOtras = input.text_area("", "Otras noticias", tooltip = "Una por línea, en hora de Nueva York:\nAAAA-MM-DD HH:MM Nombre\nEjemplo: 2026-10-16 08:30 Retail Sales", group = G1)

G2 = "2. Años a proyectar"
iAnioActual = input.bool(true, "Noticias del año en curso", group = G2)
iAnioPasado = input.bool(true, "Noticias del año pasado", group = G2)
iProyectar  = input.bool(true, "Proyectar las zonas hasta la última vela", group = G2)
iHorasZona  = input.float(24, "Largo de la zona de noticia sin proyectar (horas)", minval = 1, group = G2)

G3 = "3. Zonas que se dibujan"
iZonaNoticia  = input.bool(true, "Zona de la vela de la noticia", group = G3)
iZonaApertura = input.bool(true, "Zona de la vela de apertura de NY (9:30) en días con noticia", group = G3)
iRespaldo     = input.bool(true, "Si no hay velas de 1 min, usar las de 5 o 15 min", tooltip = "TradingView solo da velas de 1 minuto de los últimos meses. Para fechas más viejas la zona se forma con la vela de 5 o 15 minutos y la etiqueta lo indica.", group = G3)
iLineasProx   = input.bool(true, "Líneas punteadas en noticias de los próximos 7 días", group = G3)

G4 = "4. Colores y texto"
iColNoticia     = input.color(#373A46B3, "Zona de la noticia", group = G4)
iColApertura    = input.color(#2D3C55B3, "Zona de apertura", group = G4)
iColTxtNoticia  = input.color(#E91E63, "Etiqueta de la noticia", group = G4)
iColTxtApertura = input.color(color.white, "Etiqueta de apertura", group = G4)
iTamTexto       = input.string("Pequeño", "Tamaño de las etiquetas", options = ["Diminuto", "Pequeño", "Normal"], group = G4)

G5 = "5. Avisos (crear la alerta con «Cualquier llamada a la función alert()»)"
iAvisoZona   = input.bool(true, "Avisar cuando se forma la zona de una noticia", group = G5)
iMinPreaviso = input.int(5, "Avisar antes de la noticia (minutos, 0 = no)", minval = 0, group = G5)

G6 = "6. Calendario (fechas AAAA-MM-DD separadas por comas)"
iFechasCPI  = input.text_area(FECHAS_CPI,  "CPI", group = G6)
iFechasPPI  = input.text_area(FECHAS_PPI,  "PPI", group = G6)
iFechasNFP  = input.text_area(FECHAS_NFP,  "NFP", group = G6)
iFechasFOMC = input.text_area(FECHAS_FOMC, "FOMC", group = G6)

// ── Funciones ────────────────────────────────────────────────────────────────────────────────
tamTexto() =>
    iTamTexto == "Diminuto" ? size.tiny : iTamTexto == "Normal" ? size.normal : size.small

// "OCT 26" a partir de una hora.
mesAnio(int t) =>
    meses = array.from("ENE", "FEB", "MAR", "ABR", "MAY", "JUN", "JUL", "AGO", "SEP", "OCT", "NOV", "DIC")
    array.get(meses, month(t, TZ) - 1) + " " + str.tostring(year(t, TZ) % 100, "00")

diaNy(int t) =>
    timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), 0, 0)

// Agrega una lista "AAAA-MM-DD,AAAA-MM-DD,..." con la misma hora (de Nueva York) y nombre.
agregarFechas(array<int> ts, array<string> ns, string fechas, int h, int m, string nombre) =>
    for f in str.split(fechas, ",")
        p = str.split(str.replace_all(str.replace_all(f, " ", ""), "\n", ""), "-")
        if array.size(p) == 3
            y  = int(str.tonumber(array.get(p, 0)))
            mo = int(str.tonumber(array.get(p, 1)))
            d  = int(str.tonumber(array.get(p, 2)))
            if not na(y) and not na(mo) and not na(d)
                array.push(ts, timestamp(TZ, y, mo, d, h, m))
                array.push(ns, nombre)

// Agrega líneas "AAAA-MM-DD HH:MM Nombre".
agregarOtras(array<int> ts, array<string> ns, string texto) =>
    for linea in str.split(texto, "\n")
        partes = array.new<string>()
        for x in str.split(linea, " ")
            if str.length(x) > 0
                array.push(partes, x)
        if array.size(partes) >= 3
            f  = str.split(array.get(partes, 0), "-")
            hm = str.split(array.get(partes, 1), ":")
            if array.size(f) == 3 and array.size(hm) == 2
                y  = int(str.tonumber(array.get(f, 0)))
                mo = int(str.tonumber(array.get(f, 1)))
                d  = int(str.tonumber(array.get(f, 2)))
                h  = int(str.tonumber(array.get(hm, 0)))
                mi = int(str.tonumber(array.get(hm, 1)))
                if not na(y) and not na(mo) and not na(d) and not na(h) and not na(mi)
                    array.push(ts, timestamp(TZ, y, mo, d, h, mi))
                    array.push(ns, array.join(array.slice(partes, 2, array.size(partes)), " "))

// Vela (de las velas menores del gráfico) que contiene `inicio`: [hora, máximo, mínimo].
buscar(array<int> ts, array<float> hs, array<float> ls, int inicio, int duracion) =>
    int   t0 = na
    float hi = na
    float lo = na
    n = array.size(ts)
    if n > 0
        for i = 0 to n - 1
            ti = array.get(ts, i)
            if ti <= inicio and inicio < ti + duracion
                t0 := ti
                hi := array.get(hs, i)
                lo := array.get(ls, i)
                break
    [t0, hi, lo]

anioPermitido(int t) =>
    anio = year(timenow, TZ)
    a = year(t, TZ)
    (a == anio and iAnioActual) or (a == anio - 1 and iAnioPasado)

// ── Calendario y zonas (se arman una vez, en la primera vela) ─────────────────────────────────
var array<int>    evT = array.new<int>()     // noticias, ordenadas y agrupadas por hora
var array<string> evN = array.new<string>()
var array<bool>   evAvisada = array.new<bool>()
var array<int>    zT  = array.new<int>()     // zonas pendientes, ordenadas por hora de inicio
var array<string> zL  = array.new<string>()
var array<bool>   zAp = array.new<bool>()    // true = apertura de NY
var int ptr = 0

if barstate.isfirst
    crudoT = array.new<int>()
    crudoN = array.new<string>()
    if iCPI
        agregarFechas(crudoT, crudoN, iFechasCPI, 8, 30, "CPI")
    if iPPI
        agregarFechas(crudoT, crudoN, iFechasPPI, 8, 30, "PPI")
    if iNFP
        agregarFechas(crudoT, crudoN, iFechasNFP, 8, 30, "NFP")
    if iFOMC
        agregarFechas(crudoT, crudoN, iFechasFOMC, 14, 0, "FOMC")
    agregarOtras(crudoT, crudoN, iOtras)

    // Ordena por hora y junta las que salen al mismo minuto ("CPI / Retail Sales").
    orden = array.sort_indices(crudoT)
    for i in orden
        t = array.get(crudoT, i)
        n = array.get(crudoN, i)
        k = array.size(evT)
        if k > 0 and array.get(evT, k - 1) == t
            array.set(evN, k - 1, array.get(evN, k - 1) + " / " + n)
        else
            array.push(evT, t)
            array.push(evN, n)
            array.push(evAvisada, false)

    // Zonas: la vela de cada noticia y la apertura de NY de cada día con noticia.
    zonasT = array.new<int>()
    zonasL = array.new<string>()
    zonasA = array.new<bool>()
    m = array.size(evT)
    if m > 0
        for i = 0 to m - 1
            t = array.get(evT, i)
            if anioPermitido(t)
                array.push(zonasT, t)
                array.push(zonasL, array.get(evN, i) + " " + mesAnio(t))
                array.push(zonasA, false)
                if i == 0 or diaNy(array.get(evT, i - 1)) != diaNy(t)
                    // Etiqueta de la apertura: todas las noticias de ese día.
                    nombres = array.get(evN, i)
                    j = i + 1
                    while j < m and diaNy(array.get(evT, j)) == diaNy(t)
                        nombres := nombres + " / " + array.get(evN, j)
                        j += 1
                    array.push(zonasT, timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), 9, 30))
                    array.push(zonasL, nombres + " " + mesAnio(t))
                    array.push(zonasA, true)
    for i in array.sort_indices(zonasT)
        array.push(zT,  array.get(zonasT, i))
        array.push(zL,  array.get(zonasL, i))
        array.push(zAp, array.get(zonasA, i))

// ── Velas menores para formar la zona (1 min, y 5 o 15 min de respaldo) ──────────────────────
segGrafico = timeframe.in_seconds()
tf1  = segGrafico > 60  ? "1"  : timeframe.period
tf5  = segGrafico > 300 ? "5"  : timeframe.period
tf15 = segGrafico > 900 ? "15" : timeframe.period
d1   = math.min(segGrafico, 60)  * 1000
d5   = math.min(segGrafico, 300) * 1000
d15  = math.min(segGrafico, 900) * 1000
[t1, h1, l1]    = request.security_lower_tf(syminfo.tickerid, tf1,  [time, high, low])
[t5, h5, l5]    = request.security_lower_tf(syminfo.tickerid, tf5,  [time, high, low])
[t15, h15, l15] = request.security_lower_tf(syminfo.tickerid, tf15, [time, high, low])

// ── Dibujo ───────────────────────────────────────────────────────────────────────────────────
var array<box>   cajas     = array.new<box>()
var array<label> etiquetas = array.new<label>()

if not na(time_close)
    // Zonas cuya hora quedó antes de esta vela (festivo, mercado cerrado o sin historial).
    while ptr < array.size(zT) and array.get(zT, ptr) < time
        ptr += 1
    while ptr < array.size(zT) and array.get(zT, ptr) < time_close
        zs = array.get(zT, ptr)
        // En tiempo real se espera a que cierre la vela de 1 minuto de la zona.
        if barstate.isrealtime and timenow < zs + d1
            break
        [ta, ha, la] = buscar(t1, h1, l1, zs, d1)
        [tb, hb, lb] = buscar(t5, h5, l5, zs, d5)
        [tc, hc, lc] = buscar(t15, h15, l15, zs, d15)
        int    t0  = ta
        float  hi  = ha
        float  lo  = la
        string suf = ""
        if na(hi) and iRespaldo
            if not na(hb)
                t0  := tb
                hi  := hb
                lo  := lb
                suf := " (5m)"
            else if not na(hc)
                t0  := tc
                hi  := hc
                lo  := lc
                suf := " (15m)"
        esAp = array.get(zAp, ptr)
        if not na(hi) and (esAp ? iZonaApertura : iZonaNoticia)
            int finSinProyectar = esAp ? zs + 390 * 60000 : zs + int(iHorasZona * 3600000)
            int derecha = iProyectar ? time : finSinProyectar
            texto = array.get(zL, ptr) + suf
            col   = esAp ? iColApertura : iColNoticia
            ayuda = (esAp ? "Apertura NY 9:30 · " : "Noticia · ") + str.format_time(zs, "yyyy-MM-dd HH:mm", TZ) + " NY\nMáx " + str.tostring(hi, format.mintick) + " · Mín " + str.tostring(lo, format.mintick)
            array.push(cajas, box.new(t0, hi, derecha, lo, xloc = xloc.bar_time, bgcolor = col, border_color = col))
            array.push(etiquetas, label.new(derecha, hi, texto, xloc = xloc.bar_time, style = label.style_label_lower_right,
                 color = #00000000, textcolor = esAp ? iColTxtApertura : iColTxtNoticia, size = tamTexto(), tooltip = ayuda))
            if iAvisoZona and not esAp and barstate.isrealtime
                alert(texto + ": zona de la noticia · máx " + str.tostring(hi, format.mintick) + " · mín " + str.tostring(lo, format.mintick), alert.freq_once_per_bar)
        ptr += 1

// Proyección: todas las zonas llegan hasta la última vela.
if barstate.islast and iProyectar
    n = array.size(cajas)
    if n > 0
        for i = 0 to n - 1
            box.set_right(array.get(cajas, i), time)
            label.set_x(array.get(etiquetas, i), time)

// Líneas punteadas en las noticias de los próximos 7 días.
var array<line>  lineas      = array.new<line>()
var array<label> lineasTexto = array.new<label>()
if barstate.islast and iLineasProx
    for l in lineas
        line.delete(l)
    for l in lineasTexto
        label.delete(l)
    array.clear(lineas)
    array.clear(lineasTexto)
    m = array.size(evT)
    if m > 0
        for i = 0 to m - 1
            t = array.get(evT, i)
            if t > time and t <= time + 7 * 86400000
                array.push(lineas, line.new(t, close, t, close * 1.001, xloc = xloc.bar_time, extend = extend.both, style = line.style_dotted, color = iColTxtNoticia))
                array.push(lineasTexto, label.new(t, high, array.get(evN, i) + " " + str.format_time(t, "dd MMM HH:mm", TZ), xloc = xloc.bar_time,
                     style = label.style_label_left, color = #00000000, textcolor = iColTxtNoticia, size = tamTexto()))

// Aviso unos minutos antes de cada noticia.
if barstate.isrealtime and iMinPreaviso > 0
    m = array.size(evT)
    if m > 0
        for i = 0 to m - 1
            t = array.get(evT, i)
            if not array.get(evAvisada, i) and t > timenow and t - timenow <= iMinPreaviso * 60000
                array.set(evAvisada, i, true)
                alert(array.get(evN, i) + " en " + str.tostring(math.ceil((t - timenow) / 60000)) + " min (" + str.format_time(t, "HH:mm", TZ) + " NY)", alert.freq_once_per_bar)
