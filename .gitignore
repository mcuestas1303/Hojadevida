# Piezas regenerables del análisis de referencia (se rehacen con analizar_video.py)
video-studio/proyectos/*/01_referencia/analisis/frames/
video-studio/proyectos/*/01_referencia/analisis/cortes/
video-studio/proyectos/*/01_referencia/analisis/audio.wav
# Intentos descartados: pesan y no se reutilizan
video-studio/proyectos/*/04_clips/borradores/*
!video-studio/proyectos/*/04_clips/borradores/.gitkeep
__pycache__/
# Datos de las cuentas (exportaciones de estadísticas): no van al repo público
video-studio/estadisticas/datos/
# Entregas al publicador: videos y miniaturas no van al repo público (solo ficha.json)
video-studio/proyectos/*/08_entrega/**/*.mp4
video-studio/proyectos/*/08_entrega/**/*.mov
# Videos terminados y pistas que se regeneran con el código del proyecto: no van al repo público
video-studio/proyectos/*/06_final/*.mp4
video-studio/proyectos/*/06_final/*.mov
video-studio/proyectos/*/05_audio/efectos.wav
video-studio/proyectos/*/05_audio/musica.wav
video-studio/proyectos/*/05_audio/mezcla*.wav
# Diccionarios del corrector: se instalan con instalar_corrector.sh, no van al repo
video-studio/herramientas/diccionarios/

# modelo de reconocimiento de voz (1,3 GB; se descarga con instalar_oido.sh)
video-studio/herramientas/modelos_voz/

# Universo de Tin & Tan: no se sube mientras el dueño decide (tiene las respuestas del misterio; el repo es público). Copia en Drive.
video-studio/canales/nostalgia-tin-y-tan/universo/

# Graphify: el grafo se regenera con «graphify update video-studio»; solo se sube el informe
video-studio/graphify-out/*
!video-studio/graphify-out/GRAPH_REPORT.md

# Fotogramas de trabajo del render final (se regeneran con codigo/componer.py)
video-studio/proyectos/*/06_final/fotogramas/
